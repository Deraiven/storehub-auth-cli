<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.storehub.auth-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/storehub-auth</string>
        <string>--refresh-only</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.storehub/refresh.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.storehub/refresh.error.log</string>
</dict>
</plist>
